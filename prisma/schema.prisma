  performedAt DateTime @default(now())
  /// [{ set: 1, reps: 10, weightKg: 40 }, ...]
  sets        Json
  rpe         Int?
  note        String?

  createdAt DateTime @default(now())

  @@index([traineeId, performedAt])
  @@index([itemId])
}

model FoodItem {
  id String @id @default(cuid())
  /// null = platform-wide food library.
  trainerId String?

  nameAr   String
  nameEn   String
  unit     String  @default("g")
  baseQty  Decimal @default(100) @db.Decimal(8, 2)
  kcal     Decimal @db.Decimal(8, 2)
  protein  Decimal @db.Decimal(8, 2)
  carbs    Decimal @db.Decimal(8, 2)
  fat      Decimal @db.Decimal(8, 2)
  category String?
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealItems MealItem[]

  @@index([trainerId])
  @@index([isPublic])
}

model NutritionPlan {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  traineeId String?
  trainee   Trainee?       @relation(fields: [traineeId], references: [id], onDelete: SetNull)

  name        String
  description String?
  targetKcal  Int?
  targetProtein Int?
  targetCarbs   Int?
  targetFat     Int?
  isTemplate  Boolean @default(false)
  isActive    Boolean @default(true)
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals Meal[]

  @@index([trainerId, isTemplate])
  @@index([traineeId])
}

model Meal {
  id     String        @id @default(cuid())
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  type      MealType
  name      String
  order     Int      @default(0)
  timeHint  String?
  note      String?

  items MealItem[]

  @@index([planId, order])
}

model MealItem {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  foodId   String?
  food     FoodItem? @relation(fields: [foodId], references: [id], onDelete: SetNull)
  /// Free-text fallback when the food is not in the library.
  foodName String
  qty      Decimal @db.Decimal(8, 2)
  unit     String  @default("g")
  kcal     Decimal @db.Decimal(8, 2)
  protein  Decimal @db.Decimal(8, 2)
  carbs    Decimal @db.Decimal(8, 2)
  fat      Decimal @db.Decimal(8, 2)
  order    Int     @default(0)

  @@index([mealId, order])
}

model Measurement {
  id        String  @id @default(cuid())
  traineeId String
  trainee   Trainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  takenAt    DateTime @default(now())
  weightKg   Decimal? @db.Decimal(5, 1)
  bodyFatPct Decimal? @db.Decimal(4, 1)
  chestCm    Decimal? @db.Decimal(5, 1)
  waistCm    Decimal? @db.Decimal(5, 1)
  hipsCm     Decimal? @db.Decimal(5, 1)
  armCm      Decimal? @db.Decimal(5, 1)
  thighCm    Decimal? @db.Decimal(5, 1)
  neckCm     Decimal? @db.Decimal(5, 1)
  photos     String[]
  note       String?

  createdAt DateTime @default(now())

  @@index([traineeId, takenAt])
}

enum ScanStatus {
  PENDING
  DONE
  FAILED
}

enum MealVerdict {
  FITS
  OVER
  UNDER
  OFF_PLAN
}

/// A photographed meal, and what the platform made of it.
///
/// The model's job is only to read the picture: what is on the plate, roughly
/// how much of it, and the macros. The verdict below is decided in code from
/// the trainee's own targets, because "does this fit my goal" has to be
/// explainable and testable, and a sentence from a language model is neither.
model FoodScan {
  id        String  @id @default(cuid())
  traineeId String
  trainee   Trainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  /// Denormalised so a coach can list their trainees' scans without a join,
  /// and so the AI cost can be attributed to the coach who pays for it.
  trainerId String

  imageUrl String
  thumbUrl String?
  status   ScanStatus @default(PENDING)
  mealType MealType?
  title    String?

  /// [{ name, grams, kcal, protein, carbs, fat, confidence }]
  items      Json?
  kcal       Int?
  protein    Int?
  carbs      Int?
  fat        Int?
  confidence Decimal? @db.Decimal(3, 2)

  verdict         MealVerdict?
  verdictReasonAr String?
  verdictReasonEn String?

  /// The numbers the verdict was computed against, kept so it can be explained
  /// later even after the trainee's plan or weight has changed.
  calorieBudgetAtScan Int?
  consumedBeforeScan  Int?
  nutritionPlanId     String?
  aiUsageId           String?
  errorMessage        String?

  /// Set when the trainee accepts the reading and counts it against today.
  /// A scan is a look, not an entry: the day's total only moves once they say
  /// so, otherwise a curious photo of someone else's plate would ruin it.
  loggedAt DateTime?

  /// Raised by the trainee when the reading is wrong. Surfaces in the admin's
  /// scan review so a systematically bad prompt shows up as a rate, not as a
  /// story someone tells.
  reportedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([traineeId, createdAt])
  @@index([traineeId, loggedAt])
  @@index([trainerId, createdAt])
  @@index([status])
}

model Conversation {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   Trainee        @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([trainerId, traineeId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body        String
  attachments String[]
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([conversationId, createdAt])
}

// ────────────────────────────────────────────── landing pages & funnel ──

model LandingPage {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  title          String
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  /// { primary, accent, font, radius, mode: "light"|"dark" }
  theme          Json?
  status         PageStatus @default(DRAFT)
  isDefault      Boolean    @default(true)
  publishedAt    DateTime?
  viewsCount     Int        @default(0)
  leadsCount     Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks PageBlock[]
  leads  Lead[]
  views  PageView[]

  @@index([trainerId, status])
}

model PageBlock {
  id     String      @id @default(cuid())
  pageId String
  page   LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type      BlockType
  order     Int
  /// Block-specific content and settings, validated per type with Zod.
  props     Json
  isVisible Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

model Lead {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  pageId    String?
  page      LandingPage?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  name    String
  phone   String
  email   String?
  goal    String?
  message String?

  source   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  status            LeadStatus @default(NEW)
  convertedTraineeId String?
  convertedTrainee   Trainee?   @relation(fields: [convertedTraineeId], references: [id], onDelete: SetNull)
  contactedAt       DateTime?
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId, status])
  @@index([createdAt])
}

model Testimonial {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  authorName String
  authorRole String?
  avatarUrl  String?
  rating     Int     @default(5)
  body       String
  isVisible  Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([trainerId])
}

model Transformation {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  title         String?
  beforeUrl     String
  afterUrl      String
  story         String?
  durationWeeks Int?
  isVisible     Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([trainerId])
}

// ────────────────────────────────────────────── analytics & operations ──

/// First-party visitor tracking — no third-party analytics, no cross-site
/// cookies. Powers the admin traffic tab and each trainer's page stats.
model PageView {
  id        String  @id @default(cuid())
  path      String
  trainerId String?
  trainer   TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  pageId    String?
  page      LandingPage?    @relation(fields: [pageId], references: [id], onDelete: SetNull)

  /// Rotating anonymous id; not linked to a user account.
  sessionId String
  referrer  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country   String?
  device    String?
  browser   String?
  isBot     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([trainerId, createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
}

model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainerId    String?
  feature      String
  model        String
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  /// USD cost derived from token counts — feeds the admin profit report.
  costUsd      Decimal @default(0) @db.Decimal(12, 6)
  success      Boolean @default(true)
  errorMessage String?
  durationMs   Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([trainerId, createdAt])
  @@index([feature])
}

model AuditLog {
  id      String @id @default(cuid())
  actorId String?
  actor   User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  userAgent String?
  /// Set when the action was performed while impersonating another user.
  impersonatedUserId String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    String   @default("QUEUED")
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  titleAr String
  titleEn String
  bodyAr  String?
  bodyEn  String?
  link    String?
  payload Json?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Key/value store for everything the admin can configure: brand identity,
/// manual payment instructions, the Claude API key (encrypted), SEO defaults.
model AppSetting {
  key         String   @id
  value       String
  isEncrypted Boolean  @default(false)
  category    String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model StaticPage {
  id        String     @id @default(cuid())
  slug      String     @unique
  titleAr   String
  titleEn   String
  contentAr String
  contentEn String
  status    PageStatus @default(PUBLISHED)
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  variant   String   @default("info")
  audience  String   @default("ALL")
  isActive  Boolean  @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
