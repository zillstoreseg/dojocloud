// CoachMate — SaaS platform for personal trainers and their trainees.
//
// Tenancy model: every operational row carries `trainerId`. Access is enforced
// in three layers: (1) explicit guards in src/lib/authz.ts on every server
// action, (2) a Prisma client extension that injects the tenant filter, and
// (3) PostgreSQL RLS policies (phase 10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────── enums ──────

enum Role {
  ADMIN
  TRAINER
  TRAINEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
}

enum TrainsGenders {
  MALE
  FEMALE
  BOTH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Specialty {
  GENERAL_FITNESS
  WEIGHT_LOSS
  MUSCLE_GAIN
  BODYBUILDING
  POWERLIFTING
  CROSSFIT
  CALISTHENICS
  ENDURANCE
  REHAB
  POSTURE
  PRE_POSTNATAL
  KIDS
  SENIORS
  NUTRITION
  YOGA
  PILATES
  MARTIAL_ARTS
  SPORTS_PERFORMANCE
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  CANCELED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
  CASH
  KASHIER
  ZIINA
}

enum CouponType {
  PERCENT
  FIXED
}

enum CostKind {
  AI
  STORAGE
  GATEWAY
  OTHER
}

enum FlagType {
  BOOLEAN
  LIMIT
}

enum TraineeStatus {
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum TrainingGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
  STRENGTH
  ENDURANCE
  GENERAL_HEALTH
  REHAB
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  FULL_BODY
  CARDIO
  MOBILITY
}

enum Equipment {
  BODYWEIGHT
  BARBELL
  DUMBBELL
  KETTLEBELL
  MACHINE
  CABLE
  RESISTANCE_BAND
  SMITH_MACHINE
  MEDICINE_BALL
  CARDIO_MACHINE
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

enum PageStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum BlockType {
  HERO
  ABOUT
  STATS
  SERVICES
  PACKAGES
  CERTIFICATES
  TRANSFORMATIONS
  GALLERY
  VIDEO
  TESTIMONIALS
  FAQ
  CONTACT_FORM
  CTA_WHATSAPP
  SOCIAL_LINKS
  CUSTOM_HTML
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  CERTIFICATE_REVIEWED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  NEW_LEAD
  NEW_TRAINEE
  TRAINEE_RENEWAL_DUE
  NEW_MESSAGE
  QUOTA_WARNING
  SYSTEM
}

// ──────────────────────────────────────────────────── identity & access ──

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(TRAINEE)
  status       UserStatus @default(ACTIVE)
  locale       String     @default("ar")
  emailVerified DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Fine-grained permissions for staff accounts (support, finance, moderator).
  adminRoleId String?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  trainerProfile TrainerProfile?
  traineeProfile Trainee?

  notifications    Notification[]
  aiUsages         AiUsage[]
  auditLogs        AuditLog[]       @relation("AuditActor")
  sentMessages     Message[]        @relation("MessageSender")
  featureOverrides UserFeatureOverride[]

  @@index([role, status])
  @@index([createdAt])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Permission keys, e.g. ["users.read","payments.approve","plans.write"].
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model TrainerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Public handle used by the landing page URL: {domain}/c/{username}
  username         String    @unique
  usernameChangedAt DateTime?

  fullName        String
  specialties     Specialty[]
  phone           String
  country         String
  city            String?
  gender          Gender
  trainsGenders   TrainsGenders
  yearsExperience Int
  bio             String?
  avatarUrl       String?

  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?

  // Paid placement in the public coaches directory.
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?
  isListed      Boolean   @default(true)

  // Denormalised counters for the public directory. The directory filters and
  // sorts on these, so they are written when the underlying thing happens —
  // an approval, a subscription, a cancellation — and never aggregated at read
  // time. `syncDirectoryCounters` in lib/directory.ts is the only writer.
  activeTraineesCount      Int      @default(0)
  approvedCertificatesCount Int     @default(0)
  ratingAvg                Decimal? @db.Decimal(3, 2)
  ratingCount              Int      @default(0)
  /// Cheapest public package, in `startingCurrency`. Null when none is public.
  startingPrice            Decimal? @db.Decimal(12, 2)
  startingCurrency         String?
  languages                String[] @default([])

  socialLinks Json? // { instagram, tiktok, youtube, facebook, whatsapp, x }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates    Certificate[]
  subscriptions   Subscription[]
  trainees        Trainee[]
  packages        TrainerPackage[]
  exercises       Exercise[]
  workoutPrograms WorkoutProgram[]
  nutritionPlans  NutritionPlan[]
  landingPages    LandingPage[]
  leads           Lead[]
  testimonials    Testimonial[]
  transformations Transformation[]
  usernameHistory UsernameHistory[]
  pageViews       PageView[]
  conversations   Conversation[]
  wallet          Wallet?

  @@index([approvalStatus])
  @@index([isFeatured, isListed])
  @@index([country])
  // The directory's default ordering: featured first, then most subscribed.
  @@index([approvalStatus, isListed, isFeatured, activeTraineesCount])
  @@index([yearsExperience])
}

// ────────────────────────────────────────────────── wallet & payouts ──

/// A coach's money on the platform.
///
/// The two balances are held separately because they mean different things:
/// `pendingBalance` is earned but still inside the dispute-hold window (and
/// also holds the amount reserved by an open payout request), `balance` is
/// what can be withdrawn right now. Both are derived — see WalletTransaction.
model Wallet {
  id        String         @id @default(cuid())
  trainerId String         @unique
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  currency String @default("EGP")

  balance          Decimal @default(0) @db.Decimal(14, 2)
  pendingBalance   Decimal @default(0) @db.Decimal(14, 2)
  lifetimeEarned   Decimal @default(0) @db.Decimal(14, 2)
  lifetimeWithdrawn Decimal @default(0) @db.Decimal(14, 2)

  /// Set by an admin during a dispute; blocks new payout requests.
  isFrozen   Boolean @default(false)
  freezeNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]
}

enum WalletTxType {
  /// Trainee payment landed, net of platform commission.
  CREDIT
  /// Hold window elapsed: pending → available.
  HOLD_RELEASE
  /// The platform's cut, recorded for the profit report. Never hits a balance.
  COMMISSION_FEE
  /// Money leaving on an approved payout.
  PAYOUT
  /// A payout that was rejected or a refund reversing a credit.
  REVERSAL
  /// Manual correction by an admin, with a mandatory reason.
  ADJUSTMENT
}

/// Append-only ledger. Rows are never updated and never deleted; a mistake is
/// corrected with an opposing ADJUSTMENT so the history stays auditable.
/// Invariant, tested: balance + pendingBalance == Σ(amount) over all rows that
/// move money (COMMISSION_FEE is informational and excluded).
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type     WalletTxType
  /// Signed: positive adds to the coach's money, negative takes it away.
  amount   Decimal      @db.Decimal(14, 2)
  currency String

  /// Balance snapshot after this entry, so a statement never has to re-add.
  balanceAfter        Decimal @db.Decimal(14, 2)
  pendingBalanceAfter Decimal @db.Decimal(14, 2)

  /// When a CREDIT's amount becomes withdrawable. Null once released.
  availableAt DateTime?
  releasedAt  DateTime?

  refType String?
  refId   String?
  note    String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([type, availableAt])
  @@index([refType, refId])
}

enum PayoutMethod {
  BANK
  INSTAPAY
  VODAFONE_CASH
  WISE
  OTHER
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model PayoutRequest {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount   Decimal      @db.Decimal(14, 2)
  currency String
  method   PayoutMethod

  /// Bank/wallet details, encrypted at rest — decrypted only when an admin
  /// opens the request, and that read is written to the audit log.
  destination String

  status       PayoutStatus @default(PENDING)
  adminNote    String?
  proofUrl     String?
  reviewedById String?
  reviewedAt   DateTime?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, status])
  @@index([status, createdAt])
}

/// Keeps old handles resolvable with a 301 after a username change.
model UsernameHistory {
  id        String         @id @default(cuid())
  username  String         @unique
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model Certificate {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  title      String
  issuer     String?
  year       Int?
  fileUrl    String
  fileType   String?
  status     ApprovalStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId])
  @@index([status])
}

// ─────────────────────────────────────────────── plans, billing & money ──

model Plan {
  id          String  @id @default(cuid())
  key         String  @unique
  nameAr      String
  nameEn      String
  taglineAr   String?
  taglineEn   String?
  descriptionAr String?
  descriptionEn String?

  /// Multi-currency price map: { "EGP": 499, "AED": 99, "SAR": 99, "USD": 25 }
  prices   Json
  interval BillingInterval @default(MONTHLY)
  trialDays Int            @default(0)

  // Quotas (null = unlimited)
  maxTrainees       Int?
  maxLandingPages   Int?
  maxExercises      Int?
  maxNutritionPlans Int?
  maxTrainerSeats   Int  @default(1)
  aiCreditsPerCycle Int  @default(0)
  storageMb         Int  @default(500)

  /// Percentage the platform takes from trainee payments processed on-platform.
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)

  /// Marketing bullet points: { ar: string[], en: string[] }
  highlights Json?

  isActive   Boolean @default(true)
  isPopular  Boolean @default(false)
  isPublic   Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  planFeatures  PlanFeature[]

  @@index([isActive, isPublic, sortOrder])
}

model Subscription {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)

  status    SubscriptionStatus @default(PENDING_PAYMENT)
  currency  String             @default("EGP")
  amount    Decimal            @db.Decimal(12, 2)

  startsAt    DateTime?
  endsAt      DateTime?
  trialEndsAt DateTime?
  canceledAt  DateTime?
  autoRenew   Boolean   @default(false)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  counters UsageCounter[]

  @@index([trainerId, status])
  @@index([status, endsAt])
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("EGP")
  method   PaymentMethod @default(MANUAL_TRANSFER)
  status   PaymentStatus @default(PENDING)

  /// Uploaded transfer receipt — the core of the manual payment flow.
  receiptUrl String?
  reference  String?
  payerNote  String?

  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?

  /// Set by Kashier/Ziina once gateways are wired up.
  providerRef String?
  providerRaw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([subscriptionId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType @default(PERCENT)
  value          Decimal    @db.Decimal(10, 2)
  planIds        String[]
  maxRedemptions Int?
  usedCount      Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  subscriptions Subscription[]
}

/// Every platform cost, so the admin profit report can compute
/// revenue − costs = net margin per plan and per trainer.
model CostRecord {
  id        String   @id @default(cuid())
  kind      CostKind
  amountUsd Decimal  @db.Decimal(12, 6)
  trainerId String?
  planId    String?
  refType   String?
  refId     String?
  note      String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([kind, occurredAt])
  @@index([trainerId])
}

model UsageCounter {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// e.g. "ai.generations", "trainees.active", "landing.pages", "storage.mb"
  key         String
  used        Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  updatedAt   DateTime @updatedAt

  @@unique([subscriptionId, key, periodStart])
  @@index([key])
}

// ───────────────────────────────────────────────────────── feature flags ──

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  type           FlagType @default(BOOLEAN)
  defaultEnabled Boolean  @default(false)
  defaultLimit   Int?
  /// A kill switch overrides plan and user layers when disabled.
  isKillSwitch   Boolean  @default(false)
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  planFeatures  PlanFeature[]
  userOverrides UserFeatureOverride[]
}

model PlanFeature {
  id         String      @id @default(cuid())
  planId     String
  plan       Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  flagKey    String
  flag       FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  enabled    Boolean     @default(true)
  limitValue Int?

  @@unique([planId, flagKey])
}

model UserFeatureOverride {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flagKey    String
  flag       FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  enabled    Boolean
  limitValue Int?
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())

  @@unique([userId, flagKey])
}

// ──────────────────────────────────────────────────────── training core ──

model Trainee {
  id        String         @id @default(cuid())
  userId    String?        @unique
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  fullName      String
  phone         String?
  email         String?
  gender        Gender?
  birthDate     DateTime?
  heightCm      Decimal?       @db.Decimal(5, 1)
  startWeightKg Decimal?       @db.Decimal(5, 1)
  goal          TrainingGoal?
  activityLevel ActivityLevel?
  medicalNotes  String?
  injuries      String?
  notes         String?

  status      TraineeStatus @default(ACTIVE)
  startDate   DateTime      @default(now())
  renewalDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions   TraineeSubscription[]
  workoutPrograms WorkoutProgram[]
  nutritionPlans  NutritionPlan[]
  measurements    Measurement[]
  workoutLogs     WorkoutLog[]
  conversations   Conversation[]
  convertedFrom   Lead[]
  intakes         TraineeIntake[]
  foodScans       FoodScan[]

  @@index([trainerId, status])
  @@index([renewalDate])
}

model TrainerPackage {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  price         Decimal @db.Decimal(12, 2)
  currency      String  @default("EGP")
  durationDays  Int
  sessionsCount Int?
  /// Shown on the public landing page when true.
  isPublic      Boolean @default(true)
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  features      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TraineeSubscription[]

  @@index([trainerId, isActive])
}

model TraineeSubscription {
  id        String         @id @default(cuid())
  traineeId String
  trainee   Trainee        @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  packageId String
  package   TrainerPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("EGP")
  method     PaymentMethod @default(MANUAL_TRANSFER)
  receiptUrl String?
  reference  String?

  status       PaymentStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  adminNote    String?

  startsAt DateTime?
  endsAt   DateTime?

  /// Platform commission taken from this payment (plan-dependent).
  commissionAmount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([traineeId, status])
  @@index([status, createdAt])
}

/// What a trainee tells their coach when they sign up.
///
/// Kept as its own versioned row rather than folded into `Trainee`: it is a
/// snapshot of the answers on a given day, and the derived targets below are
/// stored with it so a plan written against them can still be explained later,
/// even after the trainee's weight has moved on.
model TraineeIntake {
  id        String  @id @default(cuid())
  traineeId String
  trainee   Trainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  version     Int      @default(1)
  submittedAt DateTime @default(now())

  // Goal and body
  goal         TrainingGoal
  targetWeightKg Decimal?   @db.Decimal(5, 1)
  weightKg     Decimal      @db.Decimal(5, 1)
  heightCm     Decimal      @db.Decimal(5, 1)
  gender       Gender
  birthDate    DateTime

  // Activity and sport
  activityLevel   ActivityLevel
  isAthlete       Boolean       @default(false)
  sportType       String?
  sportLevel      SportLevel?
  trainingDaysPerWeek Int       @default(3)
  sessionMinutes  Int           @default(60)
  trainingPlace   TrainingPlace @default(GYM)
  equipment       Equipment[]
  previousExperienceYears Int    @default(0)

  // Health
  injuries          String[] @default([])
  medicalConditions String[] @default([])
  medications       String?
  allergies         String[] @default([])

  // Diet and lifestyle
  dietPreference DietPreference @default(NONE)
  dislikedFoods  String[]       @default([])
  mealsPerDay    Int            @default(3)
  sleepHours     Int            @default(7)
  waterLiters    Decimal?       @db.Decimal(3, 1)
  smokes         Boolean        @default(false)
  workSchedule   String?
  stressLevel    Int            @default(3)
  notes          String?

  // Computed by lib/nutrition.ts at submit time and stored, not recomputed.
  bmi          Decimal @db.Decimal(5, 2)
  bmr          Int
  tdee         Int
  calorieTarget Int
  proteinG     Int
  carbsG       Int
  fatG         Int

  @@unique([traineeId, version])
  @@index([traineeId, submittedAt])
}

enum SportLevel {
  BEGINNER
  CLUB
  COMPETITIVE
  PRO
}

enum TrainingPlace {
  HOME
  GYM
  OUTDOOR
}

enum DietPreference {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  LOW_CARB
  HALAL_ONLY
  GLUTEN_FREE
  LACTOSE_FREE
}

model Exercise {
  id String @id @default(cuid())
  /// null = platform-wide library curated by the admin.
  trainerId String?
  trainer   TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  nameAr       String
  nameEn       String
  muscleGroup  MuscleGroup
  equipment    Equipment   @default(BODYWEIGHT)
  difficulty   Difficulty  @default(BEGINNER)
  videoUrl     String?
  imageUrl     String?
  instructionsAr String?
  instructionsEn String?
  isPublic     Boolean     @default(false)
  isActive     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutItems WorkoutItem[]

  @@index([trainerId])
  @@index([muscleGroup, equipment])
  @@index([isPublic, isActive])
}

model WorkoutProgram {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  traineeId String?
  trainee   Trainee?       @relation(fields: [traineeId], references: [id], onDelete: SetNull)

  name        String
  description String?
  goal        TrainingGoal?
  weeksCount  Int           @default(4)
  /// True when the program is a reusable template rather than an assignment.
  isTemplate  Boolean       @default(false)
  isActive    Boolean       @default(true)
  startDate   DateTime?
  /// Set when the program was drafted by the AI assistant.
  aiGenerated Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeks WorkoutWeek[]

  @@index([trainerId, isTemplate])
  @@index([traineeId])
}

model WorkoutWeek {
  id        String         @id @default(cuid())
  programId String
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int
  note       String?

  days WorkoutDay[]

  @@unique([programId, weekNumber])
}

model WorkoutDay {
  id     String      @id @default(cuid())
  weekId String
  week   WorkoutWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayNumber Int
  title     String?
